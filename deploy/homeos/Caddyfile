# HomeOS: оболочка (/opt/homeos/shell) + Wiki = tela (статика /opt/homeos/web, бэкенд 127.0.0.1:8781).
# Наружу — только через cloudflared (os.skp.kz → http://localhost:8780), за Cloudflare Access.
{
	admin localhost:2019
	auto_https off
}

:8780 {
	bind 127.0.0.1 ::1
	encode zstd gzip
	log {
		output file /var/log/caddy/homeos-access.jsonl
		format json
	}

	handle /api/internal/* {
		respond 404
	}
	@backend path /api/* /ws/* /p/* /oauth/* /dav /dav/* /.well-known/oauth-protected-resource*
	handle @backend {
		reverse_proxy 127.0.0.1:8781
	}
	handle /openapi.json {
		rewrite * /api/public/openapi.json
		reverse_proxy 127.0.0.1:8781
	}
	@share_pdf_page path_regexp sharepdfpage ^/share/([^/]+)/p/([^/]+)\.pdf$
	handle @share_pdf_page {
		rewrite * /api/share/{re.sharepdfpage.1}/pdf?p={re.sharepdfpage.2}&{query}
		reverse_proxy 127.0.0.1:8781
	}
	@share_pdf path_regexp sharepdf ^/share/([^/]+)\.pdf$
	handle @share_pdf {
		rewrite * /api/share/{re.sharepdf.1}/pdf
		reverse_proxy 127.0.0.1:8781
	}
	@og path /f/*/og.png /discover/og.png /ask/og.png /graph/og.png /atlas/og.png
	handle @og {
		reverse_proxy 127.0.0.1:8781
	}

	# ── tela (Wiki): статика и SPA ─────────────────────────────────────────────
	# Документ во фрейме оболочки — всегда tela, на любом пути (включая '/').
	@wiki_frame header Sec-Fetch-Dest iframe
	handle @wiki_frame {
		root * /opt/homeos/web
		header Cache-Control "no-cache"
		header Vary Sec-Fetch-Dest
		try_files {path} /index.html
		file_server
	}
	handle /assets/* {
		root * /opt/homeos/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Файлы из корня сборки tela (favicon, иконки).
	@wiki_file {
		not path /
		file {
			root /opt/homeos/web
			try_files {path}
		}
	}
	handle @wiki_file {
		root * /opt/homeos/web
		# Иконки и прочие нехешированные файлы: короткий кэш (Cloudflare иначе держит 4 ч).
		header Cache-Control "public, max-age=300"
		file_server
	}
	# Публичные/служебные страницы tela открываются сами по себе (ссылки из писем, шаринг).
	@wiki_standalone path /share/* /public/* /u/* /f/* /print/* /discover /discover/* /invite/* /verify-email* /reset-password* /forgot-password* /setup*
	handle @wiki_standalone {
		root * /opt/homeos/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
	# Прямые ссылки на страницы tela (в т.ч. из TELA_PUBLIC_BASE_URL) — внутрь оболочки.
	# (redir выполняется раньше handle — поэтому документы во фрейме исключаем явно.)
	@wiki_app {
		path /spaces /spaces/* /graph /graph/* /ask /ask/* /atlas /atlas/* /search /search/* /settings /settings/* /shared /shared/* /n/* /login /login/* /register /register/*
		not header Sec-Fetch-Dest iframe
	}
	redir @wiki_app /wiki{uri} 302

	# ── HomeOS shell: рельса приложений — на всё остальное (/, /wiki/…, /agents/…) ──
	handle /shell/assets/* {
		root * /opt/homeos
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /shell/* {
		root * /opt/homeos
		header Cache-Control "public, max-age=300"
		file_server
	}
	handle {
		root * /opt/homeos/shell
		header Cache-Control "no-cache"
		header Vary Sec-Fetch-Dest
		rewrite * /index.html
		file_server
	}
}
